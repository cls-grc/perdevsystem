# PerDevSys API — environment configuration template.
# Copy to .env and adjust for your environment.

# Server
PORT=4000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://postgres.jtdiyjrhjgfygdraqyob:pharmaceutic1655@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Auth
JWT_SECRET=change-me-to-a-long-random-string
# Access token lifetime in seconds (default 15 minutes)
ACCESS_TOKEN_TTL=900

# CORS
CLIENT_ORIGIN=http://localhost:5173

# OpenRouter AI (optional — reports are template-based if not set)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Email / SMTP (optional — falls back to console logging in dev)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@example.com
SMTP_PASS=
SMTP_FROM="PerDevSys <no-reply@example.com>"

